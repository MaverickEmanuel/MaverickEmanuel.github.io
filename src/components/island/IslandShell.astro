---
/**
 * The island view's DOM: canvas, floating labels, HUD (view switch, intro
 * card, theme toggle, hint, prompt, station chips), loader and the content
 * dialog. Hidden unless html.view-island is set (see Base.astro and
 * global.css). The 3D scene itself is created by src/island/ (lazy-loaded).
 */
import ThemeToggle from "@/components/ThemeToggle.astro"
import IslandPanels from "@/components/island/IslandPanels.astro"
import { site } from "@/content/site"
import { landmarks } from "@/island/landmarks"
---

<div id="island" tabindex="-1" role="region" aria-label="Island view">
  <canvas data-island-canvas class="island-canvas" aria-hidden="true"></canvas>

  <div class="island-labels" aria-hidden="true">
    {
      landmarks.map((lm) => (
        <div class="island-label" data-label={lm.id}>
          <span>{lm.label}</span>
          <small>{lm.section}</small>
        </div>
      ))
    }
  </div>

  <div class="island-hud">
    <div class="island-top">
      <button type="button" class="island-pill island-surface" data-view-switch="classic">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M4 6h16M4 12h16M4 18h10"></path>
        </svg>
        Classic view
      </button>
      <button
        type="button"
        class="island-title island-surface"
        data-open-panel="intro"
        data-needs-ready
      >
        <span class="island-title-name">{site.name}</span>
        <span class="island-title-line">{site.hero.headline}</span>
      </button>
      <ThemeToggle class="island-surface island-theme" />
    </div>

    <div class="island-bottom" data-needs-ready>
      <p class="island-hint island-surface" data-hint>
        <span class="hide-coarse">
          <kbd>WASD</kbd> or arrow keys to walk · click to move · drag to look around · scroll to zoom
        </span>
        <span class="show-coarse">Tap to walk · drag to look around · pinch to zoom</span>
      </p>
      <button type="button" class="island-prompt" data-prompt hidden>
        <span class="hide-coarse">Press <kbd aria-hidden="true">E</kbd> to open</span>
        <span class="show-coarse">Tap to open</span>
        <strong data-prompt-name></strong>
      </button>
      <nav class="island-stations" aria-label="Island stations">
        <ul>
          {
            landmarks.map((lm) => (
              <li>
                <button type="button" class="island-chip island-surface" data-station={lm.id}>
                  <span class="island-chip-name">{lm.label}</span>
                  <span class="island-chip-section">{lm.section}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <p class="sr-only" aria-live="polite" data-status></p>
  </div>

  <div class="island-loader" role="status">
    <span class="island-loader-bar" aria-hidden="true"></span>
    <span>Loading the island…</span>
  </div>

  <dialog class="island-dialog" data-island-dialog aria-labelledby="island-dialog-title">
    <div class="island-dialog-bar">
      <button type="button" class="island-dialog-close" data-close aria-label="Close">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
    <div class="island-dialog-body" data-dialog-body></div>
  </dialog>

  <IslandPanels />
</div>

<script>
  import "@/island/boot"
</script>
