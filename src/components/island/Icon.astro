---
/**
 * A Phosphor duotone icon (src/island/icons.ts), decorative only: always
 * aria-hidden, so the surrounding control must carry the accessible name.
 * The duotone fill (the opacity="0.2" path) picks up --icon-tint if set
 * (see .island-icon in global.css).
 */
import { icons, type IconName } from "@/island/icons"

interface Props {
  name: IconName
  size?: number
  class?: string
}

const { name, size = 18, class: className } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  class:list={["island-icon", className]}
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>
