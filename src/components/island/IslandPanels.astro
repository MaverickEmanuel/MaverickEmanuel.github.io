---
/**
 * Content for the island's dialog, one inert <template id="island-panel-{id}">
 * per station. Everything is rendered from src/content/site.ts,
 * the same data the classic page uses; ui.ts clones a template into the
 * dialog when a station opens. Each panel's heading is #island-dialog-title
 * (only one panel is ever in the DOM), which labels the dialog.
 */
import ExternalLink from "@/components/ExternalLink.astro"
import ProjectMedia from "@/components/ProjectMedia.astro"
import { site, type Project } from "@/content/site"

const { work, experience, offTheClock, closing, labels } = site
const { education } = experience
const projectById = (id: string) => work.projects.find((p) => p.id === id) as Project
const projects = [projectById("roflow"), projectById("demopilot")]

const titleClass =
  "m-0 font-heading text-[clamp(1.5rem,3.2vw,1.875rem)] leading-[1.12] font-semibold tracking-[-0.015em] outline-none"
---

{
  projects.map((project) => (
    <template id={`island-panel-${project.id}`}>
      <p class="eyebrow mb-2">{work.heading}</p>
      <h2 id="island-dialog-title" tabindex="-1" class={titleClass}>
        {project.title}
      </h2>
      <p class="mt-2 mb-0 text-[1.0625rem] leading-snug font-medium">{project.outcome}</p>
      <p class="mt-2 mb-0 text-[0.9375rem] leading-normal text-muted-foreground">
        {project.meta.map((part, index) => (
          <>
            {index > 0 && <span class="sr-only"> · </span>}
            <span class="block">{part}</span>
          </>
        ))}
      </p>
      <div class="mt-6">
        <ProjectMedia media={project.media} />
      </div>
      <dl class="mt-6 space-y-5">
        {[
          { label: labels.problem, text: project.problem },
          { label: labels.built, text: project.built },
          { label: labels.why, text: project.why },
        ].map((fact) => (
          <div>
            <dt class="eyebrow mb-1.5">{fact.label}</dt>
            <dd class="m-0 text-base leading-relaxed">{fact.text}</dd>
          </div>
        ))}
      </dl>
      <ul class="mt-6 flex list-none flex-wrap gap-2 p-0" aria-label="Technologies">
        {project.tags.map((tag) => (
          <li class="rounded-[7px] bg-secondary px-2.5 py-1 text-label text-secondary-foreground">
            {tag}
          </li>
        ))}
      </ul>
      <p class="mt-6 mb-0">
        <ExternalLink href={project.link.href} variant="button">
          {project.link.label}
        </ExternalLink>
      </p>
    </template>
  ))
}

<template id="island-panel-mpac">
  <p class="eyebrow mb-2">{experience.heading}</p>
  {
    experience.entries.map((entry, index) => (
      <div class:list={[index > 0 && "mt-6"]}>
        <h2
          id={index === 0 ? "island-dialog-title" : undefined}
          tabindex={index === 0 ? "-1" : undefined}
          class={titleClass}
        >
          {entry.title}
        </h2>
        {entry.organization && (
          <p class="mt-1.5 mb-0 font-medium text-primary">{entry.organization}</p>
        )}
        {entry.dates && (
          <p class="mt-1 mb-0 text-[0.9375rem] tabular-nums text-muted-foreground">{entry.dates}</p>
        )}
        {entry.description && <p class="mt-4 mb-0">{entry.description}</p>}
      </div>
    ))
  }
</template>

<template id="island-panel-queens">
  <h2 id="island-dialog-title" tabindex="-1" class={titleClass}>{education.heading}</h2>
  <ul class="mt-5 list-none space-y-4 p-0">
    {
      education.entries.map((entry) => (
        <li class="border-t border-border pt-4">
          <p class="m-0 font-medium">{entry.title}</p>
          {entry.organization && <p class="m-0 text-primary">{entry.organization}</p>}
          {entry.description && <p class="m-0 text-muted-foreground">{entry.description}</p>}
          {entry.dates && (
            <p class="m-0 text-[0.9375rem] tabular-nums text-muted-foreground">{entry.dates}</p>
          )}
        </li>
      ))
    }
  </ul>
</template>

<template id="island-panel-campfire">
  <h2 id="island-dialog-title" tabindex="-1" class={titleClass}>{offTheClock.heading}</h2>
  <p class="mt-1 mb-4 text-label text-muted-foreground">{offTheClock.updated}</p>
  <dl class="m-0">
    {
      offTheClock.items.map((item) => (
        <div class="grid gap-1 border-t border-border py-3.5 last:border-b sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:gap-6">
          <dt class="eyebrow sm:pt-[0.45em]">{item.label}</dt>
          <dd class="m-0 text-base leading-relaxed">{item.text}</dd>
        </div>
      ))
    }
  </dl>
</template>

<template id="island-panel-contact">
  <h2 id="island-dialog-title" tabindex="-1" class={titleClass}>Contact</h2>
  <p class="mt-4 mb-0 text-base">
    {closing.text}{" "}<ExternalLink href={closing.link.href}>{closing.link.label}</ExternalLink>{closing.suffix}
  </p>
  <ul class="mt-6 flex list-none flex-wrap gap-3 p-0" aria-label="Profiles">
    {
      site.profiles.map((profile) => (
        <li>
          <ExternalLink href={profile.href} variant="button">
            {profile.label}
          </ExternalLink>
        </li>
      ))
    }
  </ul>
</template>
