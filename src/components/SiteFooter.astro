---
import ExternalLink from "@/components/ExternalLink.astro"
import { site } from "@/content/site"

const { footer } = site
---

<footer class="mx-auto w-full max-w-[1120px] px-6 sm:px-8">
  <div
    class="flex items-center justify-between gap-4 border-t border-border py-8 text-sm text-muted-foreground"
  >
    <p class="m-0">{footer.copyright}</p>
    <ExternalLink href={footer.github.href}>{footer.github.label}</ExternalLink>
  </div>
</footer>
