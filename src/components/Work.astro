---
import ProjectRow from "@/components/ProjectRow.astro"
import { site } from "@/content/site"

const { work } = site
---

<section
  id="work"
  aria-labelledby="work-heading"
  class="mx-auto w-full max-w-[1120px] px-6 pb-[var(--space-section)] sm:px-8"
>
  <h2 id="work-heading" class="section-heading mb-[var(--space-heading)]" data-reveal="line">
    {work.heading}
  </h2>
  <div class="flex flex-col gap-[var(--space-section)]">
    {work.projects.map((project, index) => <ProjectRow project={project} flip={index % 2 === 1} />)}
  </div>
</section>
