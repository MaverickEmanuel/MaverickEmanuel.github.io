---
import ExternalLink from "@/components/ExternalLink.astro"
import ProjectMedia from "@/components/ProjectMedia.astro"
import { site, type Project } from "@/content/site"

interface Props {
  project: Project
  /** Media on the right (desktop). Stacked layouts always show media first. */
  flip?: boolean
}

const { project, flip = false } = Astro.props
const { labels } = site
const facts = [
  { label: labels.problem, text: project.problem },
  { label: labels.built, text: project.built },
  { label: labels.why, text: project.why },
]
---

<article
  class:list={[
    "grid items-start gap-8 lg:gap-16",
    flip
      ? "lg:grid-cols-[minmax(0,1fr)_minmax(0,1.22fr)]"
      : "lg:grid-cols-[minmax(0,1.22fr)_minmax(0,1fr)]",
  ]}
  aria-labelledby={`${project.id}-title`}
  data-reveal="row"
>
  <div class:list={["row-media w-full max-w-xl self-start lg:max-w-none", flip && "lg:order-2"]}>
    <ProjectMedia media={project.media} flip={flip} />
  </div>

  <div class="row-text min-w-0">
    <h3
      id={`${project.id}-title`}
      class="text-[clamp(1.375rem,2.2vw,1.75rem)] leading-[1.15] tracking-[-0.015em] lg:-mt-[0.12em]"
    >
      {project.title}
    </h3>
    <p class="mt-2 mb-0 max-w-[40ch] text-[1.0625rem] leading-snug font-medium text-foreground">
      {project.outcome}
    </p>
    <p class="mt-3 text-[0.9375rem] leading-normal text-muted-foreground">
      {
        project.meta.map((part, index) => (
          <>
            {index > 0 && <span class="sr-only"> · </span>}
            <span class="block">{part}</span>
          </>
        ))
      }
    </p>

    <dl class="mt-8 space-y-6">
      {
        facts.map((fact) => (
          <div>
            <dt class="eyebrow mb-1.5">{fact.label}</dt>
            <dd class="m-0 max-w-[62ch] text-base leading-relaxed">{fact.text}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="mt-7 flex list-none flex-wrap gap-2 p-0" aria-label="Technologies">
      {
        project.tags.map((tag) => (
          <li class="rounded-[7px] bg-secondary px-2.5 py-1 text-label text-secondary-foreground">
            {tag}
          </li>
        ))
      }
    </ul>

    <p class="mt-7 mb-0">
      <ExternalLink href={project.link.href} variant="button">
        {project.link.label}
      </ExternalLink>
    </p>
  </div>
</article>
