---
import { site } from "@/content/site"

const { offTheClock } = site
---

<section
  id="off-the-clock"
  aria-labelledby="off-the-clock-heading"
  class="mx-auto w-full max-w-[1120px] px-6 pb-[var(--space-section-sm)] sm:px-8"
>
  <h2 id="off-the-clock-heading" class="section-heading mb-4" data-reveal="line">
    {offTheClock.heading}
  </h2>
  <div data-reveal="fade">
    <p class="mb-5 text-label text-muted-foreground">{offTheClock.updated}</p>
    <dl class="m-0 max-w-3xl">
      {
        offTheClock.items.map((item) => (
          <div class="grid gap-1 border-t border-border py-4 last:border-b sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-8">
            <dt class="eyebrow sm:pt-[0.45em]">{item.label}</dt>
            <dd class="m-0 text-base leading-relaxed">{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
