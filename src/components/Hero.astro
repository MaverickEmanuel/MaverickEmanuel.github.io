---
import Portrait from "@/components/Portrait.astro"
import { site } from "@/content/site"

const { hero } = site
---

<section id="intro" aria-labelledby="intro-heading" class="w-full overflow-x-clip">
  <div
    class="mx-auto grid w-full max-w-[1120px] px-6 pt-6 pb-24 sm:px-8 md:pt-12 md:pb-32 items-center gap-8 md:grid-cols-[minmax(0,1fr)_220px] md:gap-12 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-24"
  >
    <div class="enter relative z-10 md:col-start-1 md:row-start-1">
      <p class="mb-5 text-base font-medium tracking-[0.01em] text-muted-foreground">
        {hero.greeting}
      </p>
      <h1 id="intro-heading" class="max-w-[15em] text-balance">{hero.headline}</h1>
      <div class="mt-7 max-w-[62ch] space-y-4">
        {hero.paragraphs.map((text) => <p>{text}</p>)}
      </div>
    </div>

    <div
      class="enter relative order-first w-40 md:order-none md:col-start-2 md:row-start-1 md:w-full md:justify-self-end"
    >
      <div class="hero-wash" aria-hidden="true"></div>
      <div class="relative z-10">
        <Portrait />
      </div>
    </div>
  </div>
</section>
