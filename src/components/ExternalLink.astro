---
interface Props {
  href: string
  class?: string
}

const { href, class: className } = Astro.props
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={["link inline-flex items-baseline gap-1 rounded-sm", className]}
>
  <span><slot /></span>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="14"
    height="14"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    class="relative top-[0.1em] shrink-0 self-center"
  >
    <path d="M7 17 17 7M8 7h9v9"></path>
  </svg>
  <span class="sr-only"> (opens in a new tab)</span>
</a>
