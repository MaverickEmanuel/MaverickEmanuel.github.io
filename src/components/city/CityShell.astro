---
/**
 * The city view's DOM: canvas, floating labels, HUD (view switch, intro
 * card, theme toggle, hint, prompt, station chips), loader and the content
 * dialog. Hidden unless html.view-city is set (see Base.astro and
 * global.css). The 3D scene itself is created by src/city/ (lazy-loaded).
 */
import ThemeToggle from "@/components/ThemeToggle.astro"
import CityPanels from "@/components/city/CityPanels.astro"
import { site } from "@/content/site"
import { landmarks } from "@/city/landmarks"
---

<div id="city" tabindex="-1" role="region" aria-label="City view">
  <canvas data-city-canvas class="city-canvas" aria-hidden="true"></canvas>

  <div class="city-labels" aria-hidden="true">
    {
      landmarks.map((lm) => (
        <div class="city-label" data-label={lm.id}>
          <span>{lm.label}</span>
          <small>{lm.section}</small>
        </div>
      ))
    }
  </div>

  <div class="city-hud">
    <div class="city-top">
      <button type="button" class="city-pill city-surface" data-view-switch="classic">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M4 6h16M4 12h16M4 18h10"></path>
        </svg>
        Classic view
      </button>
      <button
        type="button"
        class="city-title city-surface"
        data-open-panel="intro"
        data-needs-ready
      >
        <span class="city-title-name">{site.name}</span>
        <span class="city-title-line">{site.hero.headline}</span>
      </button>
      <ThemeToggle class="city-surface city-theme" />
    </div>

    <div class="city-bottom" data-needs-ready>
      <!--
        Touch-only joystick (shown under pointer: coarse, see global.css),
        wired by Controls.attachJoystick. Hidden from assistive tech: the
        station buttons and the keyboard cover everything it does.
      -->
      <div class="city-joystick" data-joystick aria-hidden="true">
        <span class="city-joystick-knob" data-joystick-knob></span>
      </div>
      <p class="city-hint city-surface" data-hint>
        <span class="hide-coarse">
          <kbd>WASD</kbd> or arrow keys to walk · <kbd>Space</kbd> to jump · click to move · drag to look around ·
          scroll to zoom
        </span>
        <span class="show-coarse">Joystick or tap to walk · drag to look around · pinch to zoom</span>
      </p>
      <button type="button" class="city-prompt" data-prompt hidden>
        <span class="hide-coarse">Press <kbd aria-hidden="true">E</kbd> to open</span>
        <span class="show-coarse">Tap to open</span>
        <strong data-prompt-name></strong>
      </button>
      <nav class="city-stations" aria-label="City stations">
        <ul>
          {
            landmarks.map((lm) => (
              <li>
                <button type="button" class="city-chip city-surface" data-station={lm.id}>
                  <span class="city-chip-name">{lm.label}</span>
                  <span class="city-chip-section">{lm.section}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <p class="sr-only" aria-live="polite" data-status></p>
  </div>

  <div class="city-loader" role="status">
    <span class="city-loader-bar" aria-hidden="true"></span>
    <span>Loading the city…</span>
  </div>

  <dialog class="city-dialog" data-city-dialog aria-labelledby="city-dialog-title">
    <div class="city-dialog-bar">
      <button type="button" class="city-dialog-close" data-close aria-label="Close">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
    <div class="city-dialog-body" data-dialog-body></div>
  </dialog>

  <CityPanels />
</div>

<script>
  import "@/city/boot"
</script>
