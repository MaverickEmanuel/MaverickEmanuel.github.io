---
import { site } from "@/content/site"

const { experience } = site
const { education } = experience
---

<section
  id="experience"
  aria-labelledby="experience-heading"
  class="mx-auto w-full max-w-[1120px] px-6 pb-[var(--space-section)] sm:px-8"
>
  <h2 id="experience-heading" class="section-heading mb-[var(--space-heading)]" data-reveal="line">
    {experience.heading}
  </h2>

  <div data-reveal="fade">
    {/* The current role is the strongest entry on the page. */}
    <ul class="m-0 list-none p-0">
      {
        experience.entries.map((entry) => (
          <li class="pt-1 pb-7">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
              <p class="m-0 max-w-[40rem] text-[clamp(1.25rem,2vw,1.5rem)] leading-snug font-semibold tracking-[-0.01em] font-heading">
                {entry.title}
                {entry.organization && (
                  <span class="mt-0.5 block text-base font-medium text-primary">
                    {entry.organization}
                  </span>
                )}
              </p>
              {entry.dates && (
                <p class="m-0 text-[0.9375rem] whitespace-nowrap text-foreground tabular-nums">
                  {entry.dates}
                </p>
              )}
            </div>
            {entry.description && (
              <p class="mt-3 mb-0 max-w-[62ch] text-base text-foreground">
                {entry.description}
              </p>
            )}
          </li>
        ))
      }
    </ul>

    {/* Quieter sub-group: smaller, muted, lighter weight. */}
    <div class="border-t border-border pt-5">
      <h3 class="eyebrow mb-3">{education.heading}</h3>
      <ul class="m-0 list-none space-y-2.5 p-0 text-[0.9375rem] leading-normal text-muted-foreground">
        {
          education.entries.map((entry) => (
            <li class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
              <p class="m-0 max-w-[40rem]">
                {entry.title}
                {entry.organization && (
                  <span class="block">{entry.organization}</span>
                )}
                {entry.description && (
                  <span class="block">{entry.description}</span>
                )}
              </p>
              {entry.dates && (
                <p class="m-0 text-sm whitespace-nowrap tabular-nums">{entry.dates}</p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
