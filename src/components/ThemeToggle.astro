---
import { Button } from "@/components/ui/button"
---

{/*
  Rendered server-side only (no client:* directive). Icons show the theme the
  button will switch TO, driven purely by the `.dark` class (no JS, no flash).
  The static label matches the dark default; the inline script below keeps it
  in sync on every change. Hidden when scripts are off (see Base.astro).
*/}
<Button
  id="theme-toggle"
  type="button"
  variant="ghost"
  size="icon-lg"
  aria-label="Switch to light theme"
>
  <svg
    class="dark:hidden"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  <svg
    class="hidden dark:block"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
</Button>

<script is:inline>
  (function () {
    var button = document.getElementById("theme-toggle")
    if (!button) return
    var root = document.documentElement
    var themeColor = document.getElementById("theme-color")

    function apply(theme) {
      root.classList.toggle("dark", theme === "dark")
      root.style.colorScheme = theme
      button.setAttribute(
        "aria-label",
        theme === "dark" ? "Switch to light theme" : "Switch to dark theme"
      )
      if (themeColor)
        themeColor.setAttribute("content", theme === "dark" ? "#1B1917" : "#FAF6EE")
    }

    apply(root.classList.contains("dark") ? "dark" : "light")

    button.addEventListener("click", function () {
      var next = root.classList.contains("dark") ? "light" : "dark"
      apply(next)
      try {
        localStorage.setItem("theme", next)
      } catch (e) {}
    })
  })()
</script>
