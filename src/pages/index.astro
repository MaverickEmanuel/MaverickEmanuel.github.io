---
import Base from "@/layouts/Base.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import Hero from "@/components/Hero.astro"
import Work from "@/components/Work.astro"
import Experience from "@/components/Experience.astro"
import OffTheClock from "@/components/OffTheClock.astro"
import Closing from "@/components/Closing.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import CityShell from "@/components/city/CityShell.astro"
import { site } from "@/content/site"
---

<Base title={site.title} description={site.description}>
  {/* The 3D city view (the default with JS); hidden unless html.view-city. */}
  <CityShell />

  {/* The classic page: always fully rendered (no-JS, SEO, screen readers). */}
  <div id="classic">
    <p id="city-note" class="city-note" role="status" hidden>
      The 3D city couldn't start in this browser, so you're seeing the classic view.
    </p>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <Hero />
      <Work />
      <Experience />
      <OffTheClock />
      <Closing />
    </main>
    <SiteFooter />
  </div>
</Base>
