---
import Base from "@/layouts/Base.astro"
import ThemeToggle from "@/components/ThemeToggle.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import { site } from "@/content/site"
---

{/*
  GitHub Pages serves this for any missing path, at any depth, so every link
  and asset here is root-absolute. Base.astro still sets html.view-island or
  html.view-classic. This page has no island, so the inline script drops
  view-island before first paint; otherwise its scroll lock (global.css) could
  clip the page on short screens.
*/}
<Base title={`Page not found · ${site.name}`} description={site.description}>
  <script is:inline>
    document.documentElement.classList.remove("view-island")
  </script>
  <div class="flex min-h-screen flex-col">
    <header
      class="mx-auto flex w-full max-w-[1120px] items-center justify-between gap-2 px-6 py-3 min-[30rem]:py-4 sm:px-8 sm:py-5"
    >
      <a
        href="/"
        class="rounded-sm font-heading text-base font-semibold tracking-tight whitespace-nowrap min-[30rem]:text-lg"
      >
        {site.name}
      </a>
      <ThemeToggle />
    </header>
    <main
      id="main"
      tabindex="-1"
      class="mx-auto flex w-full max-w-[1120px] flex-1 flex-col justify-center px-6 py-16 sm:px-8"
    >
      <p class="m-0 text-base text-muted-foreground">404</p>
      <h1 class="mt-3 mb-0 font-heading text-4xl font-semibold tracking-tight sm:text-5xl">
        This page isn't on the map.
      </h1>
      <p class="mt-5 mb-0 max-w-[52ch] text-base text-muted-foreground">
        The link may be old or mistyped. Everything I've built is on the homepage.
      </p>
      <p class="mt-8 mb-0">
        <a href="/" class="link text-base font-medium">Back to the homepage</a>
      </p>
    </main>
    <SiteFooter />
  </div>
</Base>
