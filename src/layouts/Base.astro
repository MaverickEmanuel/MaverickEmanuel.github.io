---
import "../styles/global.css"
import AgentIntro from "@/components/AgentIntro.astro"
import { site } from "@/content/site"
import interUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url"
import instrumentUrl from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url"

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const introEnabled = site.intro.enabled
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta id="theme-color" name="theme-color" content="#1B1917" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={instrumentUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!--
      Dark is the default (and the no-JS state: the class is in the markup).
      Render-blocking on purpose: a saved choice of "light" (localStorage
      "theme") removes the class before first paint. System preference is
      deliberately ignored.
    -->
    <script is:inline>
      (function () {
        var theme = "dark"
        try {
          if (localStorage.getItem("theme") === "light") theme = "light"
        } catch (e) {}
        var root = document.documentElement
        root.classList.toggle("dark", theme === "dark")
        root.style.colorScheme = theme
        document
          .getElementById("theme-color")
          .setAttribute("content", theme === "dark" ? "#1B1917" : "#FAF6EE")
      })()
    </script>
    <!--
      Entrance motion is opt-in: the hidden "before" states in global.css only
      exist under html.js-motion, which is set here before first paint, and only
      when the browser can run the observer and has not asked for reduced
      motion. Failsafes drop the class (everything shows at once) if the
      observer script never reports in within 2.5s, and before printing.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement
        if (
          !("IntersectionObserver" in window) ||
          matchMedia("(prefers-reduced-motion: reduce)").matches
        )
          return
        root.classList.add("js-motion")
        function reveal() {
          root.classList.remove("js-motion")
        }
        setTimeout(function () {
          if (!root.hasAttribute("data-motion-ready")) reveal()
        }, 2500)
        window.addEventListener("beforeprint", reveal)
      })()
    </script>
    <!--
      First-visit intro (AgentIntro.astro). Decided here, before first paint, so
      returning visitors never see the overlay and first-time visitors never see
      the page flash first. Fails open: reduced motion, no inert support or no
      localStorage means no intro, and so does no JS (nothing adds the class).
      "intro-seen" is stored now, so a reload mid-intro does not replay it. The
      failsafe drops the overlay after 7s if the intro script never started
      (once started, it has its own 7s failsafe). Off: `intro.enabled` in site.ts.
    -->
    {introEnabled && (
      <script is:inline>
        (function () {
          var root = document.documentElement
          try {
            if (
              matchMedia("(prefers-reduced-motion: reduce)").matches ||
              !("inert" in HTMLElement.prototype) ||
              localStorage.getItem("intro-seen")
            )
              return
            localStorage.setItem("intro-seen", "1")
          } catch (e) {
            return
          }
          root.classList.add("intro")
          setTimeout(function () {
            if (root.hasAttribute("data-intro-ready")) return
            root.classList.remove("intro", "intro-leaving")
            document.querySelectorAll("body > [inert]").forEach(function (el) {
              el.inert = false
            })
          }, 7000)
        })()
      </script>
    )}
    <noscript>
      <style>
        #theme-toggle {
          display: none;
        }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen">
    {introEnabled && <AgentIntro />}
    <a
      href="#main"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-2 focus-visible:left-2 focus-visible:z-50 focus-visible:rounded-md focus-visible:bg-background focus-visible:px-3 focus-visible:py-2 focus-visible:text-foreground"
    >
      Skip to content
    </a>
    <slot />
    <script is:inline>
      // Scroll reveals: add .is-visible once per [data-reveal] element; the
      // transitions live in global.css.
      (function () {
        var root = document.documentElement
        if (!root.classList.contains("js-motion")) return
        var io = new IntersectionObserver(
          function (entries) {
            root.setAttribute("data-motion-ready", "")
            entries.forEach(function (entry) {
              // Also reveal anything already scrolled past (reload, deep link).
              if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
                entry.target.classList.add("is-visible")
                io.unobserve(entry.target)
              }
            })
          },
          { threshold: 0.15 }
        )
        document.querySelectorAll("[data-reveal]").forEach(function (el) {
          io.observe(el)
        })
      })()
    </script>
  </body>
</html>
